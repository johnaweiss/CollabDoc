{
 "id": "./",
 "name": "CollabDoc",
 "start_url": "./index.html",
 "display": "standalone",
 "icons": [
  {
   "src": "./icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "./icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  }
 ],
 "file_handlers": [
  {
   "action": "./index.html",
   "accept": {
    "text/html": [
     ".html",
     ".htm"
    ]
   }
  }
 ],
 "protocol_handlers": [
  {
   "protocol": "web+collabdoc",
   "url": "./index.html?msg=%s"
  }
 ],
 "launch_handler": {
  "client_mode": [
   "focus-existing",
   "auto"
  ]
 }
}
